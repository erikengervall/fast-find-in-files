{
  "name": "fast-find-in-files",
  "version": "1.0.5",
  "description": "Recursively search a directory's files for text or a RegExp, powered by a native C++ addon",
  "keywords": [
    "find",
    "search",
    "grep",
    "files",
    "regex",
    "text",
    "native",
    "napi"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "prebuilds/**/*",
    "src/**/*.cc",
    "src/**/*.h",
    "binding.gyp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikengervall/fast-find-in-files.git"
  },
  "homepage": "https://github.com/erikengervall/fast-find-in-files#readme",
  "bugs": {
    "url": "https://github.com/erikengervall/fast-find-in-files/issues"
  },
  "author": "Erik Engervall <erik.engervall@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "gypfile": true,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules build dist prebuilds",
    "prep": "yarn && yarn build",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint .",
    "install": "node-gyp-build",
    "format": "prettier --write .",
    "prebuildify": "prebuildify --napi --strip"
  },
  "dependencies": {
    "node-addon-api": "^8",
    "node-gyp-build": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/jest": "^30",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "jest": "^30",
    "node-gyp": "^13.0.2",
    "prebuildify": "^6",
    "prettier": "^3",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5.9",
    "typescript-eslint": "^8"
  }
}

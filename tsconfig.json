{
  "compilerOptions": {
    "outDir": "./dist",
    "esModuleInterop": true,
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["./src-node/**/*.ts"],
  "exclude": ["./src-node/**/*.spec.ts"]
}
